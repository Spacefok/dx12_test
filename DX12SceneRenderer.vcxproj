  <Target Name="CompileRayTracedShadowShaders" BeforeTargets="ClCompile"
          Inputs="$(ProjectDir)shader\RayTracedShadows.hlsl;$(MSBuildProjectFullPath)"
          Outputs="$(IntDir)RayTracedShadowTrace.h;$(IntDir)RayTracedShadowFilter.h">
    <PropertyGroup>
      <RayShadowDxc>$([System.String]::Copy('$(WindowsSDK_ExecutablePath_x64)').Split(';')[0])\dxc.exe</RayShadowDxc>
      <RayShadowFlags>-O3</RayShadowFlags>
      <RayShadowFlags Condition="'$(Configuration)'=='Debug'">-Zi -Qembed_debug -Od</RayShadowFlags>
    </PropertyGroup>
    <Error Condition="!Exists('$(RayShadowDxc)')" Text="DXC is required for inline ray tracing. Install a recent Windows 10/11 SDK in Visual Studio." />
    <MakeDir Directories="$(IntDir)" />
    <Exec Command="&quot;$(RayShadowDxc)&quot; -T cs_6_5 -E CSTraceShadows -WX $(RayShadowFlags) -Fh &quot;$(IntDir)RayTracedShadowTrace.h&quot; -Vn g_RayTracedShadowTrace &quot;$(ProjectDir)shader\RayTracedShadows.hlsl&quot;" />
    <Exec Command="&quot;$(RayShadowDxc)&quot; -T cs_6_5 -E CSFilterShadows -WX $(RayShadowFlags) -Fh &quot;$(IntDir)RayTracedShadowFilter.h&quot; -Vn g_RayTracedShadowFilter &quot;$(ProjectDir)shader\RayTracedShadows.hlsl&quot;" />
